CREATE TABLE CATEGORIA (
    id_categoria INT PRIMARY KEY,
    nombre_categoria VARCHAR(50) NOT NULL
);

CREATE TABLE SEDE_CAMPUS (
    id_sede INT PRIMARY KEY,
    nombre_sede VARCHAR(100) NOT NULL
);

CREATE TABLE FACULTAD (
    id_facultad INT PRIMARY KEY,
    nombre_facultad VARCHAR(100) NOT NULL
);

CREATE TABLE CICLO_SEMESTRE (
    id_ciclo INT PRIMARY KEY,
    nombre_ciclo VARCHAR(50) NOT NULL
);

CREATE TABLE SECCION (
    id_seccion INT PRIMARY KEY,
    nombre_seccion VARCHAR(7) NOT NULL
);

CREATE TABLE JORNADAS (
    id_jornada NUMBER PRIMARY KEY,
    nombre_jornada VARCHAR2(50) NOT NULL,
    hora_inicio VARCHAR2(8),
    hora_fin VARCHAR2(8),
    dias_semana VARCHAR2(50),
    activo NUMBER(1) DEFAULT 1
);

CREATE TABLE ROLES (
    id_rol NUMBER PRIMARY KEY,
    nombre_rol VARCHAR2(50) NOT NULL,
    descripcion VARCHAR2(200),
    activo NUMBER(1) DEFAULT 1
);

CREATE TABLE USUARIOS (
    carne VARCHAR2(20) PRIMARY KEY,
    nombres VARCHAR2(100) NOT NULL,
    apellidos VARCHAR2(100) NOT NULL,
    correo_institucional VARCHAR2(100) UNIQUE NOT NULL,
    contrasena VARCHAR2(255) NOT NULL,
    telefono VARCHAR2(15),
    direccion VARCHAR2(255),
    fecha_registro TIMESTAMP DEFAULT SYSTIMESTAMP,
    activo NUMBER(1) DEFAULT 1,
    id_categoria INT,
    id_sede INT,
    id_facultad INT,
    id_ciclo INT,
    id_seccion INT,
    id_jornada NUMBER,
    id_rol NUMBER,
    CONSTRAINT chk_contrasena CHECK (LENGTH(contrasena) >= 8),
    FOREIGN KEY (id_categoria) REFERENCES CATEGORIA(id_categoria),
    FOREIGN KEY (id_sede) REFERENCES SEDE_CAMPUS(id_sede),
    FOREIGN KEY (id_facultad) REFERENCES FACULTAD(id_facultad),
    FOREIGN KEY (id_ciclo) REFERENCES CICLO_SEMESTRE(id_ciclo),
    FOREIGN KEY (id_seccion) REFERENCES SECCION(id_seccion),
    FOREIGN KEY (id_jornada) REFERENCES JORNADAS(id_jornada),
    FOREIGN KEY (id_rol) REFERENCES ROLES(id_rol)
);

CREATE TABLE TARJETAS_ACCESO (
    id_tarjeta NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    carne_usuario VARCHAR2(20) NOT NULL,
    codigo_tarjeta VARCHAR2(50) UNIQUE NOT NULL,
    uid_tarjeta VARCHAR2(50) UNIQUE,
    fecha_emision TIMESTAMP DEFAULT SYSTIMESTAMP,
    fecha_expiracion DATE,
    activa NUMBER(1) DEFAULT 1,
    observaciones VARCHAR2(200),
    FOREIGN KEY (carne_usuario) REFERENCES USUARIOS(carne) ON DELETE CASCADE
);

CREATE TABLE VEHICULOS (
    id_vehiculo NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    carne_usuario VARCHAR2(20) NOT NULL,
    tipo_vehiculo VARCHAR2(20) DEFAULT 'AUTOMOVIL',
    placa VARCHAR2(15) UNIQUE NOT NULL,
    marca VARCHAR2(50),
    modelo VARCHAR2(50),
    color VARCHAR2(30),
    activo NUMBER(1) DEFAULT 1,
    fecha_registro TIMESTAMP DEFAULT SYSTIMESTAMP,
    FOREIGN KEY (carne_usuario) REFERENCES USUARIOS(carne) ON DELETE CASCADE,
    CONSTRAINT chk_tipo_vehiculo CHECK (tipo_vehiculo IN ('AUTOMOVIL', 'MOTOCICLETA', 'CAMIONETA', 'OTRO'))
);

CREATE TABLE DATOS_EMERGENCIA (
    id_emergencia NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    carne_usuario VARCHAR2(20) NOT NULL,
    nombre_contacto VARCHAR2(100) NOT NULL,
    telefono_emergencia VARCHAR2(15) NOT NULL,
    parentesco VARCHAR2(50),
    FOREIGN KEY (carne_usuario) REFERENCES USUARIOS(carne) ON DELETE CASCADE
);

CREATE TABLE REGISTRO_ACCESOS (
    id_acceso NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    carne_usuario VARCHAR2(20) NOT NULL,
    fecha_hora_entrada TIMESTAMP DEFAULT SYSTIMESTAMP,
    fecha_hora_salida TIMESTAMP,
    tipo_acceso VARCHAR2(20) DEFAULT 'ENTRADA',
    acceso_permitido NUMBER(1) DEFAULT 1,
    motivo_denegacion VARCHAR2(200),
    observaciones VARCHAR2(200),
    FOREIGN KEY (carne_usuario) REFERENCES USUARIOS(carne) ON DELETE CASCADE,
    CONSTRAINT chk_tipo_acceso CHECK (tipo_acceso IN ('ENTRADA', 'SALIDA'))
);

CREATE INDEX idx_usuarios_categoria ON USUARIOS(id_categoria);
CREATE INDEX idx_usuarios_sede ON USUARIOS(id_sede);
CREATE INDEX idx_usuarios_facultad ON USUARIOS(id_facultad);
CREATE INDEX idx_usuarios_ciclo ON USUARIOS(id_ciclo);
CREATE INDEX idx_usuarios_seccion ON USUARIOS(id_seccion);
CREATE INDEX idx_usuarios_jornada ON USUARIOS(id_jornada);
CREATE INDEX idx_usuarios_rol ON USUARIOS(id_rol);
CREATE INDEX idx_tarjetas_usuario ON TARJETAS_ACCESO(carne_usuario);
CREATE INDEX idx_vehiculos_usuario ON VEHICULOS(carne_usuario);
CREATE INDEX idx_vehiculos_placa ON VEHICULOS(placa);
CREATE INDEX idx_emergencia_usuario ON DATOS_EMERGENCIA(carne_usuario);
CREATE INDEX idx_accesos_usuario ON REGISTRO_ACCESOS(carne_usuario);
CREATE INDEX idx_accesos_fecha ON REGISTRO_ACCESOS(fecha_hora_entrada);

